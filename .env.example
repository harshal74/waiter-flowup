# ── Waiter Frontend Environment Variables ────────────────────────
# Copy to .env and fill in values for your environment.

# API base URL
# Dev: leave unset — Vite proxy forwards /api → localhost:5000
# Prod: set to your Render backend URL
# VITE_API_URL=https://your-backend.onrender.com/api

# Socket.IO server URL
# Dev: http://localhost:5000
# Prod: https://your-backend.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Restaurant identifier — must match RESTAURANT_ID in backend .env
VITE_RESTAURANT_ID=FLOWUP001

# NOTE: UPI ID is NOT an environment variable.
# It is stored in the restaurant's Settings in MongoDB
# and configured through Admin → Settings → UPI ID.
# The waiter billing system reads it from the database automatically.
